{
  "manifest_version": 3,
  "name": "Sweeter",
  "version": "0.18.3",
  "description": "A Tweetbot-style face for X Pro. Reads the timelines X Pro already loads and sends nothing of its own.",
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js" },
  "host_permissions": ["https://pro.x.com/*", "https://cdn.dexscreener.com/*", "https://dd.dexscreener.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["https://pro.x.com/*"],
      "js": ["src/page/recorder.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://pro.x.com/*"],
      "js": [
        "src/lib/util.js",
        "src/lib/text.js",
        "src/lib/normalize.js",
        "src/lib/mutes.js",
        "src/lib/filters.js",
        "src/lib/decks.js",
        "src/lib/store.js",
        "src/content/xpro.js",
        "src/ui/symbols.js",
        "src/ui/mark.js",
        "src/ui/icons.js",
        "src/ui/styles.js",
        "src/ui/render.js",
        "src/ui/palette.js",
        "src/ui/app.js",
        "src/content/main.js"
      ],
      "run_at": "document_start"
    }
  ]
}
